{
  "name": "codex-auto-reset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep track of banked Codex resets and redeem them before they expire.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "auto-reset": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "test:browser": "playwright test",
    "status": "node src/cli.mjs status",
    "check": "node src/cli.mjs check",
    "check:dry": "node src/cli.mjs check --dry-run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0"
  }
}
