[Unit]
Description=Watch and apply expiring Codex usage resets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/auto-reset
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node %h/auto-reset/src/cli.mjs serve
# To listen on your tailnet, append: --host 100.x.y.z
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=default.target
